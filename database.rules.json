{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[A-Za-z0-9_-]{6,64}$/)",
        ".write": "auth != null && $room.matches(/^[A-Za-z0-9_-]{6,64}$/)",

        "days": {
          "$day": {
            ".validate": "newData.isNumber() && $day.matches(/^([1-9]|[1-9][0-9]|100)$/)"
          }
        },

        "meta": {
          "startDate": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "$other": { ".validate": false }
        },

        "messages": {
          "$id": {
            ".validate": "newData.hasChildren(['at', 'by', 'text'])",
            "at": { ".validate": "newData.isNumber()" },
            "by": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
